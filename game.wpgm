import wollok.game.*
import personaje.*
import cultivos.*
import direcciones.*
import herramientas.*
import market.*

program farmville {
	//  CONFIG	
	game.title("La granja")
	game.height(10)
	game.width(10)
	game.ground("ground.png")

	//  VISUALES
 	game.addVisual(personaje)
	game.addVisual(marketNorte)
	game.addVisual(marketSur)
	game.addVisual(contadorBaul)
	// game.addVisual(contadorOro)

	keyboard.a().onPressDo({personaje.mover(izquierda)})
	keyboard.d().onPressDo({personaje.mover(derecha)})
	keyboard.w().onPressDo({personaje.mover(arriba)})
	keyboard.s().onPressDo({personaje.mover(abajo)})
	keyboard.m().onPressDo({personaje.sembrar(new Maiz(position = personaje.position()))})
	keyboard.t().onPressDo({personaje.sembrar(new Trigo(position = personaje.position()))})
	keyboard.o().onPressDo({personaje.sembrar(new Tomaco(position = personaje.position()))})
	keyboard.r().onPressDo({personaje.regar()})
	keyboard.c().onPressDo({personaje.cosechar()})
	keyboard.v().onPressDo({personaje.vender()})
	keyboard.space().onPressDo({personaje.hacerInventario()})
	keyboard.e().onPressDo({
		const aspersor = new Aspersor(position = personaje.position())
		personaje.ponerHerramienta(aspersor)
		aspersor.activarAspersor()
	})

	//  COMIENZA
	game.start()
}
